# Database Configuration (Free Neon Serverless Postgres: https://neon.tech)
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-endpoint>.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=<your-neon-password>

# JWT Security Key (64+ characters recommended)
JWT_SECRET=SuperSecretKeyForJobSeekingPlatformJwtTokenGenerator2026!

# Spring Mail (Optional - for real email verification)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
